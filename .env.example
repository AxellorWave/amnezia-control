# токен от @BotFather
BOT_TOKEN=123456:ABC...
# твой Telegram id (узнать у @userinfobot), несколько — через запятую
ADMIN_IDS=111111111
VPN_HOST=vpn.example.com
# имя сервера в приложении AmneziaVPN (по умолчанию vpn)
SERVER_NAME=vpn

# Обычно менять не нужно — проверь командами из README
CONTAINER=amnezia-awg2
CONF_DIR=/opt/amnezia/awg
IFACE=awg0
WG_BIN=awg
WG_QUICK_BIN=awg-quick
DNS1=1.1.1.1
DNS2=1.0.0.1
MTU=1280
# устройств на пользователя (админам без лимита)
MAX_DEVICES=5
# кастомные эмодзи (нужен Telegram Premium у владельца бота); 0 — обычные
CUSTOM_EMOJI=1
