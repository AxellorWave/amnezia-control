# токен от @BotFather
BOT_TOKEN=123456:ABC...
# твой Telegram id (узнать у @userinfobot), несколько — через запятую
ADMIN_IDS=111111111
# домен сервера (лучше домен, а не IP: при смене IP достаточно поменять A-запись)
VPN_HOST=vpn.example.com
# имя сервера в приложениях (AmneziaVPN, название подписки)
SERVER_NAME=vpn

# --- AmneziaWG: определяется автоматически по контейнеру amnezia-awg2 / amnezia-awg.
# Задавай, только если нужно указать явно (старые значения из прошлых версий тоже работают)
# CONTAINER=amnezia-awg2
# CONF_DIR=/opt/amnezia/awg
# IFACE=awg0
# WG_BIN=awg
# WG_QUICK_BIN=awg-quick
DNS1=1.1.1.1
DNS2=1.0.0.1
MTU=1280
# устройств на пользователя: AWG-устройства + устройства подписки (админам без лимита)
MAX_DEVICES=5
# кастомные эмодзи (нужен Telegram Premium у владельца бота); 0 — обычные
CUSTOM_EMOJI=1

# --- сервер подписок (VLESS + Hysteria2)
# адрес в ссылке подписки (по умолчанию VPN_HOST), порт и адрес прослушивания
# SUB_HOST=sub.example.com
SUB_PORT=2096
SUB_LISTEN=0.0.0.0
# 1 — без заголовка x-hwid подписку не отдавать; 0 — считать «неизвестным устройством»
HWID_REQUIRED=0
# порты на 127.0.0.1: auth-хук Hysteria2, API Xray, статистика Hysteria2
# HY2_AUTH_PORT=18081
# XRAY_API_PORT=10085
# HY2_STATS_PORT=18082

# --- резервные копии: полная копия админам раз в N дней (0 — выключено), хранить N последних
BACKUP_EVERY_DAYS=0
BACKUP_KEEP=7

# путь к ./data на хосте — определяется сам через docker inspect; задай, если не получилось
# HOST_DATA_DIR=/opt/amnezia-bot/data
# путь к базе стран по IP (по умолчанию рядом с DB_PATH, скачивается автоматически)
# GEOIP_DB=/data/dbip-country-lite.mmdb
